name: PR
on:
  pull_request:
    branches: [main]

concurrency:
  group: pr-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-jvm:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: zulu        # kmp.new pins the Gradle daemon to Azul Zulu 21
          java-version: 21          # (gradle/gradle-daemon-jvm.properties) — match it, no per-run JDK download
      # setup-gradle v6: its caching is the proprietary `gradle-actions-caching` component — using it
      # accepts Gradle's Terms of Use (https://gradle.com/legal/terms-of-use/). Pin `@v5` (MIT) instead
      # if your project can't accept them. https://blog.gradle.org/github-actions-for-gradle-v6
      - uses: gradle/actions/setup-gradle@v6
      - name: Spotless (ktlint)
        run: ./gradlew spotlessCheck
      - name: Detekt
        run: ./gradlew detekt
      - name: Build
        run: ./gradlew build -x test
      - name: Host tests (commonTest + jvmTest source sets)
        run: ./gradlew jvmTest
      - name: Coverage threshold (Kover)
        run: ./gradlew koverVerify
      - name: Coverage report
        if: success() || failure()
        run: ./gradlew koverXmlReport koverHtmlReport
      - uses: actions/upload-artifact@v7
        if: success() || failure()
        with:
          name: kover-report
          path: '**/build/reports/kover/'
          if-no-files-found: ignore

  build-ios:
    if: ${{ vars.IOS_ENABLED == 'true' }}
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: zulu        # kmp.new pins the Gradle daemon to Azul Zulu 21
          java-version: 21          # (gradle/gradle-daemon-jvm.properties) — match it, no per-run JDK download
      - uses: gradle/actions/setup-gradle@v6
      - name: Link iOS framework (simulator arm64)
        run: ./gradlew :shared:linkReleaseFrameworkIosSimulatorArm64
