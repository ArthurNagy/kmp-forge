name: PR
on:
  pull_request:
    branches: [main]

concurrency:
  group: pr-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-jvm:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
      - name: Spotless (ktlint)
        run: ./gradlew spotlessCheck
      - name: Detekt
        run: ./gradlew detekt
      - name: Build
        run: ./gradlew build -x test
      - name: Common tests
        run: ./gradlew :composeApp:commonTest :domain:commonTest :data:commonTest
      - name: Coverage threshold (Kover)
        run: ./gradlew koverVerify
      - name: Coverage report
        if: success() || failure()
        run: ./gradlew koverXmlReport koverHtmlReport
      - uses: actions/upload-artifact@v4
        if: success() || failure()
        with:
          name: kover-report
          path: '**/build/reports/kover/'
          if-no-files-found: ignore

  build-ios:
    if: ${{ vars.IOS_ENABLED == 'true' }}
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
      - name: Link iOS framework (simulator arm64)
        run: ./gradlew :composeApp:linkReleaseFrameworkIosSimulatorArm64
