name: PR
on:
  pull_request:
    branches: [main]

concurrency:
  group: pr-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-jvm:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
      - name: Detekt
        run: ./gradlew detekt
      - name: Build
        run: ./gradlew build -x test
      - name: Common tests
        run: ./gradlew :composeApp:commonTest :domain:commonTest :data:commonTest

  build-ios:
    if: ${{ vars.IOS_ENABLED == 'true' }}
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
      - name: Link iOS framework (simulator arm64)
        run: ./gradlew :composeApp:linkReleaseFrameworkIosSimulatorArm64
