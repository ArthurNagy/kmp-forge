name: Release
on:
  push:
    tags: ['v*']

jobs:
  android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/setup-java@v6
        with:
          distribution: zulu        # kmp.new pins the Gradle daemon to Azul Zulu 21
          java-version: 21          # (gradle/gradle-daemon-jvm.properties) — match it, no per-run JDK download
      # setup-gradle v6: its caching is the proprietary `gradle-actions-caching` component — using it
      # accepts Gradle's Terms of Use (https://gradle.com/legal/terms-of-use/). Pin `@v5` (MIT) instead
      # if your project can't accept them. https://blog.gradle.org/github-actions-for-gradle-v6
      - uses: gradle/actions/setup-gradle@v6
      - name: Decode keystore
        env:
          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
        run: echo "$ANDROID_KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.keystore"
      # Signs via AGP's injected signing properties (the same ones Android Studio's
      # "Generate Signed Bundle" uses) — no signingConfig in androidApp/build.gradle.kts and
      # no keystore path in the repo. Without these the APK/AAB would ship unsigned.
      - name: Build signed release AAB + APK
        env:
          KEYSTORE_PATH: ${{ runner.temp }}/release.keystore
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: >-
          ./gradlew :androidApp:bundleRelease :androidApp:assembleRelease
          -Pandroid.injected.signing.store.file="$KEYSTORE_PATH"
          -Pandroid.injected.signing.store.password="$KEYSTORE_PASSWORD"
          -Pandroid.injected.signing.key.alias="$KEY_ALIAS"
          -Pandroid.injected.signing.key.password="$KEY_PASSWORD"
      - uses: actions/upload-artifact@v7
        with:
          name: android
          path: |
            androidApp/build/outputs/bundle/release/*.aab
            androidApp/build/outputs/apk/release/*.apk
          if-no-files-found: error

  ios:
    if: ${{ vars.IOS_ENABLED == 'true' }}
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/setup-java@v6
        with:
          distribution: zulu        # kmp.new pins the Gradle daemon to Azul Zulu 21
          java-version: 21          # (gradle/gradle-daemon-jvm.properties) — match it, no per-run JDK download
      - uses: gradle/actions/setup-gradle@v6
      - name: Build framework
        run: ./gradlew :shared:linkReleaseFrameworkIosArm64
      - name: Archive
        run: |
          xcodebuild -project iosApp/iosApp.xcodeproj \
                     -scheme iosApp \
                     -configuration Release \
                     -destination 'generic/platform=iOS' \
                     -archivePath build/iosApp.xcarchive \
                     archive
      - name: Export IPA
        run: |
          xcodebuild -exportArchive \
                     -archivePath build/iosApp.xcarchive \
                     -exportPath build/ipa \
                     -exportOptionsPlist iosApp/ExportOptions.plist
      - uses: actions/upload-artifact@v7
        with:
          name: ios
          path: build/ipa/*.ipa
          if-no-files-found: error

  desktop:
    if: ${{ vars.DESKTOP_ENABLED == 'true' }}
    strategy:
      matrix:
        os: [macos-latest, windows-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/setup-java@v6
        with:
          distribution: zulu        # kmp.new pins the Gradle daemon to Azul Zulu 21
          java-version: 21          # (gradle/gradle-daemon-jvm.properties) — match it, no per-run JDK download
      - uses: gradle/actions/setup-gradle@v6
      - name: Package desktop distribution (current OS)
        run: ./gradlew :desktopApp:packageReleaseDistributionForCurrentOS
      - uses: actions/upload-artifact@v7
        with:
          name: desktop-${{ matrix.os }}
          path: |
            desktopApp/build/compose/binaries/main-release/dmg/*.dmg
            desktopApp/build/compose/binaries/main-release/msi/*.msi
            desktopApp/build/compose/binaries/main-release/deb/*.deb
          if-no-files-found: ignore

  changelog-and-release:
    # Wait for every artifact job. ios/desktop are skipped unless their repo variable is
    # set, so require android to succeed and nothing to have failed (skipped is fine).
    needs: [android, ios, desktop]
    if: ${{ !cancelled() && needs.android.result == 'success' && !contains(needs.*.result, 'failure') }}
    runs-on: ubuntu-latest
    # Creating a Release needs write access; new repos default GITHUB_TOKEN to read-only.
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@v8
        with:
          path: artifacts
      - name: Generate changelog
        id: cliff
        uses: orhun/git-cliff-action@v4
        with:
          config: cliff.toml
          args: --latest --strip header
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v3
        with:
          body: ${{ steps.cliff.outputs.content }}
          files: |
            artifacts/android/**/*.aab
            artifacts/android/**/*.apk
            artifacts/ios/**/*.ipa
            artifacts/desktop-*/**/*.dmg
            artifacts/desktop-*/**/*.msi
            artifacts/desktop-*/**/*.deb
          generate_release_notes: false
