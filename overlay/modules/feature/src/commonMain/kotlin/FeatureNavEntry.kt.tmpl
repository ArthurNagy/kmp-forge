package ${BASE_PACKAGE}.feature.${FEATURE_NAME_PKG}

import androidx.navigation3.runtime.EntryProviderScope
import androidx.navigation3.runtime.NavKey

/**
 * Navigation 3 entry contribution for this feature — the **only** screen-facing
 * public API of `:feature-${FEATURE_NAME}`. [${FEATURE_NAME_PASCAL}Screen] / [${FEATURE_NAME_PASCAL}ViewModel] /
 * [${FEATURE_NAME_PASCAL}State] stay `internal`; the app composes the feature by calling this from
 * its `NavDisplay(entryProvider = entryProvider { add${FEATURE_NAME_PASCAL}Entries(...) })`
 * (`:shared`'s AppNavigation.kt).
 *
 * Outgoing navigation is passed in as callbacks so the feature stays decoupled —
 * the app owns the back stack and any target routes. A feature never imports
 * another feature's Route; to navigate forward, take an `onOpenX: (Arg) -> Unit`
 * callback here and let the app supply `{ backStack.add(OtherRoute(it)) }`.
 *
 * Plural (`...Entries`) because a feature can host multiple screens — add another
 * `entry<OtherRoute> { OtherScreen(...) }` line here as the feature grows
 * (see /kmp-forge-add-screen). Every Route must also be registered in `:shared`'s
 * navigation SerializersModule (AppNavigation.kt) or saving the back stack throws.
 */
fun EntryProviderScope<NavKey>.add${FEATURE_NAME_PASCAL}Entries(onNavigateBack: () -> Unit) {
    entry<${FEATURE_NAME_PASCAL}Route> {
        ${FEATURE_NAME_PASCAL}Screen(onNavigateBack = onNavigateBack)
    }
}
