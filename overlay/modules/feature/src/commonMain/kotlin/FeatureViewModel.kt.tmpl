package ${BASE_PACKAGE}.feature.${FEATURE_NAME}

import androidx.lifecycle.ViewModel
import org.orbitmvi.orbit.ContainerHost
import org.orbitmvi.orbit.viewmodel.container

internal class ${FEATURE_NAME_PASCAL}ViewModel : ViewModel(), ContainerHost<${FEATURE_NAME_PASCAL}State, Nothing> {

    override val container = container<${FEATURE_NAME_PASCAL}State, Nothing>(${FEATURE_NAME_PASCAL}State.Initial)

    fun load() = intent {
        reduce { state.copy(loading = true, error = null) }
        // TODO: inject a use case from :domain via the constructor and consume its
        //   Result<T, DomainError> with kotlin-result (import com.github.michaelbull.result.*):
        //     getX()
        //         .onSuccess { data -> reduce { state.copy(loading = false, /* ... = data */) } }
        //         .onFailure { error -> reduce { state.copy(loading = false, error = error) } }
        reduce { state.copy(loading = false) }
    }

    /** Paired with `state.pendingMessage` — UI calls this after rendering the toast/snackbar. */
    fun onPendingMessageConsumed() = intent {
        reduce { state.copy(pendingMessage = null) }
    }
}
