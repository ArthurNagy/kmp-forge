package ${BASE_PACKAGE}.feature.${FEATURE_NAME_PKG}

import androidx.lifecycle.ViewModel
import org.orbitmvi.orbit.OrbitContainerHost
import org.orbitmvi.orbit.viewmodel.orbitContainer

/**
 * State-only Orbit host: the side-effect type is always `Nothing` (one-shot events are
 * consumable slots on [${FEATURE_NAME_PASCAL}State], never `postSideEffect`).
 */
internal class ${FEATURE_NAME_PASCAL}ViewModel :
    ViewModel(),
    OrbitContainerHost<${FEATURE_NAME_PASCAL}State, ${FEATURE_NAME_PASCAL}State, Nothing> {
    override val container = orbitContainer<${FEATURE_NAME_PASCAL}State, Nothing>(${FEATURE_NAME_PASCAL}State.Initial)

    fun load() = intent {
        reduce { state.copy(loading = true, error = null) }
        // Replace with a use case from :domain, injected via the constructor, and consume its
        // Result<T, DomainError> with kotlin-result (import com.github.michaelbull.result.onOk
        // and com.github.michaelbull.result.onErr):
        //     getX()
        //         .onOk { data -> reduce { state.copy(loading = false, /* ... = data */) } }
        //         .onErr { error -> reduce { state.copy(loading = false, error = error) } }
        reduce { state.copy(loading = false) }
    }

    /** Paired with `state.pendingMessage` — UI calls this after rendering the snackbar. */
    fun onPendingMessageConsumed() = intent {
        reduce { state.copy(pendingMessage = null) }
    }
}
