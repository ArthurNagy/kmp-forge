package ${BASE_PACKAGE}.feature.${FEATURE_NAME_PKG}

import kotlinx.coroutines.test.runTest
import org.orbitmvi.orbit.test.testWithInternalState
import kotlin.test.Test

class ${FEATURE_NAME_PASCAL}ViewModelTest {
    @Test
    fun loadTogglesLoadingFlag() = runTest {
        val vm = ${FEATURE_NAME_PASCAL}ViewModel()

        // Orbit 12: the initial state is asserted automatically before this block runs.
        vm.testWithInternalState(this, ${FEATURE_NAME_PASCAL}State.Initial) {
            containerHost.load()
            expectInternalState { copy(loading = true, error = null) }
            expectInternalState { copy(loading = false) }
        }
    }

    @Test
    fun pendingMessageClearsAfterConsumed() = runTest {
        val vm = ${FEATURE_NAME_PASCAL}ViewModel()

        vm.testWithInternalState(this, ${FEATURE_NAME_PASCAL}State.Initial.copy(pendingMessage = "Hi")) {
            containerHost.onPendingMessageConsumed()
            expectInternalState { copy(pendingMessage = null) }
        }
    }
}
