import org.jetbrains.kotlin.gradle.dsl.JvmTarget

plugins {
    id("kmp-forge.kmp.library")
    alias(libs.plugins.androidMultiplatformLibrary)
    alias(libs.plugins.composeMultiplatform)
    alias(libs.plugins.composeCompiler)
}

kotlin {
    android {
        namespace = "${BASE_PACKAGE}.ui"
        compileSdk = libs.versions.android.compileSdk.get().toInt()
        minSdk = libs.versions.android.minSdk.get().toInt()
        compilerOptions {
            jvmTarget = JvmTarget.JVM_17
        }
        // Required for Compose resources under the AGP KMP library plugin: without it :ui's strings
        // (DomainError.toMessage()) are not packaged into the APK and stringResource() crashes on Android.
        androidResources {
            enable = true
        }
    }

    sourceSets {
        commonMain.dependencies {
            implementation(libs.compose.runtime)
            implementation(libs.compose.foundation)
            implementation(libs.compose.material3)
            implementation(libs.compose.ui)
            implementation(libs.compose.components.resources)
            implementation(project(":domain"))
            implementation(libs.koin.core)
        }
        commonTest.dependencies {
            implementation(libs.kotlin.test)
            implementation(libs.compose.uiTest)
        }
    }
}

// :ui's strings live in src/commonMain/composeResources/values/strings.xml (the unqualified default
// table). Pin the generated Res class to a stable package; it stays `internal` (the default).
compose.resources {
    packageOfResClass = "${BASE_PACKAGE}.ui.resources"
}
