<?xml version="1.0" encoding="utf-8"?>
<!--
  Default string table for :ui — the messages DomainError.toMessage() shows, plus text the shared
  composables need. Compose Multiplatform falls back ONLY to this unqualified values/ directory: every
  key must exist here. Translations go in values-<locale>/strings.xml. See docs/i18n-a11y.md.
-->
<resources>
    <string name="error_connectivity">No connection. Check your connection and try again.</string>
    <string name="error_server">The server ran into a problem. Please try again later.</string>
    <string name="error_not_found">That item is no longer available.</string>
    <string name="error_unknown">Something went wrong. Please try again.</string>
</resources>
