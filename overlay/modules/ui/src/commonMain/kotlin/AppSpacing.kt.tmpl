package ${BASE_PACKAGE}.ui

import androidx.compose.ui.unit.dp

/**
 * Spacing tokens. Used for paddings, gaps, list separators.
 * Composables should use these instead of magic-number .dp values.
 */
object AppSpacing {
    val none = 0.dp
    val xs = 4.dp
    val sm = 8.dp
    val md = 16.dp
    val lg = 24.dp
    val xl = 32.dp
    val xxl = 48.dp
}
