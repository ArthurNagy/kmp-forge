package ${BASE_PACKAGE}

import androidx.compose.runtime.Composable
import ${BASE_PACKAGE}.ui.AppTheme

/**
 * Composition root — every platform entry point (MainActivity, MainViewController, desktop/web
 * `main`) renders this. Owned by kmp-forge: hosts the theme and the Nav 3 back stack
 * ([AppNavigation], AppNavigation.kt).
 *
 * Koin is already running when this composes: each entry point calls [startAppKoin] (AppKoin.kt)
 * first, so services and background work resolve from the same graph as the screens.
 */
@Composable
fun App() {
    AppTheme {
        AppNavigation()
    }
}
